{
  "expo": {
    "name": "luxjson",
    "slug": "luxjson",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon/luxjson-icon.png",
    "scheme": "luxjson",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.luxjson",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/luxjson-icon.png",
        "backgroundColor": "#0027c4"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/BOLD.ttf"
          ]
        }
      ],
      "@react-native-vector-icons/material-icons",
      "@react-native-vector-icons/fontawesome6",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0027c4",
          "image": "./assets/icon/splash.jpg",
          "imageWidth": 120
        }
      ],
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "332b916e-d5d5-4313-bf0b-123739d64fa2"
      }
    },
    "owner": "luxjsonreserva"
  }
}
